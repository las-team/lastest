{
  "name": "lastest",
  "version": "0.1.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"pnpm dev:next\" \"pnpm dev:pool\"",
    "devsafe": "rm -rf .next && pnpm dev",
    "dev:next": "node scripts/front-proxy.js -- next dev -H 127.0.0.1",
    "dev:pool": "pnpm --filter @lastest/pool-service dev",
    "build:pool": "pnpm --filter @lastest/pool-service build",
    "start:pool": "pnpm --filter @lastest/pool-service start",
    "build": "pnpm --filter @lastest/mcp-server build && next build",
    "start": "node scripts/front-proxy.js -- next start -H 127.0.0.1",
    "prepare": "node .husky/install.mjs || true",
    "lint": "eslint",
    "types": "NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:studio": "drizzle-kit studio",
    "db:push": "node scripts/migrate.js",
    "db:push:raw": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:reset": "node scripts/db-reset.js",
    "db:seed": "tsx scripts/seed-excalidraw-tests.ts",
    "audit:playwright-parity": "tsx scripts/audit-playwright-parity.ts",
    "test:visual": "tsx scripts/run-tests.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "arch": "node tools/architecture/report.mjs",
    "arch:baseline": "node tools/architecture/report.mjs --baseline",
    "arch:split-pr": "node tools/architecture/check-split-pr.mjs",
    "schema:graph": "node tools/architecture/schema-graph.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "ocr:up": "docker compose up -d --build ocr",
    "ocr:down": "docker compose rm -sf ocr",
    "deploy:zima": "bash scripts/deploy.sh zima",
    "deploy:olares": "bash scripts/deploy.sh olares",
    "deploy:npm": "bash scripts/deploy.sh npm",
    "deploy:all": "bash scripts/deploy.sh all",
    "stack": "bash scripts/k3d-up.sh",
    "stack:up": "bash scripts/k3d-up.sh",
    "stack:stop": "bash scripts/k3d-down.sh",
    "stack:down": "bash scripts/k3d-down.sh",
    "stack:purge": "bash scripts/k3d-down.sh --purge",
    "stack:refresh": "bash scripts/k3d-rebuild-eb.sh",
    "stack:refresh:eb": "bash scripts/k3d-rebuild-eb.sh",
    "stack:logs": "bash scripts/k3d-logs.sh",
    "stack:logs:eb": "bash scripts/k3d-logs.sh eb",
    "stack:status": "bash scripts/k3d-status.sh"
  },
