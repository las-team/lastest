{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["../src/*"],
      // `server-only` is a Next build-time guard with no Node entry point.
      // Scripts run under plain tsx, so anything reaching `@/lib/core/runtime`
      // (the plugin deletion cascade, for one) fails to resolve it without this
      // stub — the same one `vitest.config.ts` aliases in for the same reason.
      "server-only": ["../test-stubs/server-only.ts"]
    }
  }
}
