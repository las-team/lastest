  "dependencies": {
    "commander": "^12.0.0",
    "pino": "^10.3.1",
    "yaml": "^2.9.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
