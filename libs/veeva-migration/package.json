{
  "name": "@lastest/veeva-migration",
  "version": "0.1.0",
  "private": true,
  "description": "Veeva CRM (Salesforce) → Vault CRM migration engine (spec: docs/MIGRATION_SPEC.md)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config/schema": "./src/config/schema.ts",
    "./run": "./src/run/index.ts",
