{
  "name": "@lastest/plugin-qa-agent",
  "version": "0.1.0",
  "private": true,
  "description": "QA Agent: an autonomous, repeatable suite builder — discover the app on a core-issued browser, plan a coverage matrix, generate and run tests, heal what fails, and report PR coverage. Driven manually, by cron, by PR webhook, or from a task queue.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./actions": "./src/actions.ts",
    "./host": "./src/host.ts",
    "./page": "./src/ui/page.tsx",
    "./reads": "./src/reads.ts",
    "./schema": "./src/schema.ts",
    "./types": "./src/types.ts",
    "./ui/qa-agent-client": "./src/ui/qa-agent-client.tsx",
    "./ui/qa-task-board": "./src/ui/qa-task-board.tsx",
    "./ui/qa-trigger-config": "./src/ui/qa-trigger-config.tsx",
    "./wiring": "./src/wiring.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lastest/contracts": "workspace:*",
    "@lastest/core-data": "workspace:*",
    "@lastest/cron": "workspace:*",
    "@lastest/eb-protocol": "workspace:*",
    "@lastest/github": "workspace:*",
    "@lastest/kernel": "workspace:*",
    "@lastest/route-scan": "workspace:*",
    "@lastest/test-templates": "workspace:*",
    "@lastest/ui": "workspace:*",
    "@lastest/url-canonical": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/react": "^19",
    "lucide-react": "^0.562.0",
    "next": "16.2.11",
    "react": "19.2.3",
    "sonner": "^2.0.7",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "license": "FSL-1.1-ALv2"
}
