    "./generator": "./src/generator.ts",
    "./host": "./src/host.ts",
    "./redact": "./src/redact.ts",
    "./runner": "./src/runner.ts",
    "./ui/api-test-dialog": "./src/ui/api-test-dialog.tsx",
    "./ui/api-test-form": "./src/ui/api-test-form.tsx",
    "./wiring": "./src/wiring.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lastest/ai-kit": "workspace:*",
