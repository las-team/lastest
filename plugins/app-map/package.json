{
  "name": "@lastest/plugin-app-map",
  "version": "0.1.0",
  "private": true,
  "description": "The App Map: a repo's pages merged from route scan, sitemap, QA crawl and test trajectories into one node-network, with per-page coverage status.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./actions": "./src/actions.ts",
    "./host": "./src/host.ts",
    "./page": "./src/ui/page.tsx",
    "./wiring": "./src/wiring.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@lastest/contracts": "workspace:*",
    "@lastest/eb-protocol": "workspace:*",
    "@lastest/kernel": "workspace:*",
    "@lastest/ui": "workspace:*",
    "@lastest/url-canonical": "workspace:*",
    "@xyflow/react": "^12.11.2",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@types/react": "^19",
    "lucide-react": "^0.562.0",
    "next": "16.2.11",
    "react": "19.2.3",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "license": "FSL-1.1-ALv2"
}
