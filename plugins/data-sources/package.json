{
  "name": "@lastest/plugin-data-sources",
  "version": "0.1.0",
  "private": true,
  "description": "Cached, alias-keyed tabular test data: uploaded CSV files and linked Google Sheets, referenced from test code via {{csv:alias...}} / {{sheet:alias...}}.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./actions": "./src/actions.ts",
    "./host": "./src/host.ts",
    "./reads": "./src/reads.ts",
    "./schema": "./src/schema.ts",
    "./wiring": "./src/wiring.ts",
    "./ui/csv-sources-card": "./src/ui/csv-sources-settings-card.tsx",
    "./ui/google-sheets-card": "./src/ui/google-sheets-settings-card.tsx",
    "./ui/sheet-data-preview": "./src/ui/sheet-data-preview.tsx",
    "./ui/sheet-reference-inserter": "./src/ui/sheet-reference-inserter.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lastest/contracts": "workspace:*",
    "@lastest/core-data": "workspace:*",
    "@lastest/core-storage": "workspace:*",
    "@lastest/csv": "workspace:*",
    "@lastest/google-sheets": "workspace:*",
    "@lastest/kernel": "workspace:*",
    "@lastest/ui": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.562.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@types/react": "^19",
    "next": "16.2.11",
    "react": "^19",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "license": "FSL-1.1-ALv2"
}
