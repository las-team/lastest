{
  "name": "@lastest/plugin-rca",
  "version": "0.1.0",
  "private": true,
  "description": "Root-cause analysis for visual diffs: classify a diff, correlate it across tests, and cluster a build's failures into causes.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./actions": "./src/actions.ts",
    "./host": "./src/host.ts",
    "./ui/rca-badge": "./src/ui/rca-badge.tsx",
    "./ui/rca-panel": "./src/ui/rca-panel.tsx",
    "./wiring": "./src/wiring.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lastest/contracts": "workspace:*",
    "@lastest/eb-protocol": "workspace:*",
    "@lastest/kernel": "workspace:*",
    "@lastest/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19",
    "lucide-react": "^0.562.0",
    "next": "16.2.11",
    "react": "19.2.3",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
