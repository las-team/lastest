{
  "name": "@lastest/plugin-share",
  "version": "0.1.0",
  "private": true,
  "description": "Public share links: publish a build/test to an unauthenticated /r/<slug> landing page, claim it into a fresh team, and the recording/diff/a11y presentation that renders it.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./claim-page": "./src/ui/claim/page.tsx",
    "./host": "./src/host.ts",
    "./not-found": "./src/ui/not-found.tsx",
    "./page": "./src/ui/page.tsx",
    "./schema": "./src/schema.ts",
    "./wiring": "./src/wiring.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lastest/contracts": "workspace:*",
    "@lastest/core-data": "workspace:*",
    "@lastest/eb-protocol": "workspace:*",
    "@lastest/kernel": "workspace:*",
    "@lastest/playback": "workspace:*",
    "@lastest/ui": "workspace:*",
    "@lastest/video-fallback": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/react": "^19",
    "next": "16.2.11",
    "react": "19.2.3",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "license": "FSL-1.1-ALv2"
}
