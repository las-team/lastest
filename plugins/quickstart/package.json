{
  "name": "@lastest/plugin-quickstart",
  "version": "0.1.0",
  "private": true,
  "description": "QuickStart: a one-click, nine-step agent that scouts a founder's own site, captures a demo login, generates and runs a walkthrough test, and publishes a founder-facing /r/<slug> outreach share.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./actions": "./src/actions.ts",
    "./gating": "./src/gating.ts",
    "./host": "./src/host.ts",
    "./step-definitions": "./src/step-definitions.ts",
    "./types": "./src/types.ts",
    "./ui/quickstart-panel": "./src/ui/quickstart-panel.tsx",
    "./ui/use-quickstart": "./src/ui/use-quickstart.ts",
    "./ui/email-template-input": "./src/ui/email-template-input.tsx",
    "./wiring": "./src/wiring.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lastest/contracts": "workspace:*",
    "@lastest/kernel": "workspace:*",
    "@lastest/test-templates": "workspace:*",
    "@lastest/ui": "workspace:*",
    "@lastest/video-fallback": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19",
    "lucide-react": "^0.562.0",
    "next": "16.2.11",
    "react": "19.2.3",
    "sonner": "^2.0.7",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "license": "FSL-1.1-ALv2"
}
