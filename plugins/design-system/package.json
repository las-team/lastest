{
  "name": "@lastest/plugin-design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Design-system token compliance: parse a repo's design tokens from CSS, compare computed styles against them, and score the result. Contributes the 'design' check layer.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./actions": "./src/actions.ts",
    "./check-layer": "./src/check-layer.ts",
    "./host": "./src/host.ts",
    "./score": "./src/score.ts",
    "./wiring": "./src/wiring.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lastest/contracts": "workspace:*",
    "@lastest/design-tokens": "workspace:*",
    "@lastest/eb-protocol": "workspace:*",
    "@lastest/kernel": "workspace:*"
  },
  "devDependencies": {
    "jszip": "^3.10.1",
    "next": "16.2.11",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "license": "FSL-1.1-ALv2"
}
