# =============================================================================
# Lastest — database migration image (run once per deploy, not per app pod)
#
# The split-services app image (Dockerfile.app) does NOT migrate at boot. This
# image runs scripts/migrate.js (pre-create/backfill SQL + `drizzle-kit push
# --force`) as a one-shot k8s Job (k8s/migrate-job.yaml) or `docker run`.
#
# It installs EXACTLY three packages — nothing from the app dependency tree,
# no workspace install:
#   - drizzle-kit  : the `push` CLI (bundles the config + schema with esbuild)
#   - drizzle-orm  : the schema's only runtime import (drizzle-orm/pg-core)
#   - postgres     : the DB driver drizzle-kit connects through, and what
#                    migrate.js's pre-steps require() for the backfill SQL
#
# Almost no @lastest/* workspace package is needed: packages/db/src/schema.ts
# imports @lastest/eb-protocol and @lastest/triage-model as `import type` only
# (and re-exports them as `export type`), both of which esbuild — drizzle-kit's
# schema loader — erases without resolving. So the schema barrel plus its own
# ./schema/ directory are copied; those cross-package imports vanish. The barrel
# `export * from "./schema/<mod>"` is a VALUE re-export, so esbuild DOES resolve
# it — the directory must come along.
#
# The one exception is @lastest/coverage-model: schema/coverage.ts and
# schema/tests.ts re-export its DEFAULT_* policies as VALUES, so esbuild must
# resolve it. It is a dependency-free pure-TypeScript lib, so it is dropped in
# as a bare node_modules entry (its package.json "main" points at src/index.ts,
# which esbuild loads as TS) rather than dragging in a pnpm workspace install.
#
# NOT traced. scripts/migrate.js talks to `postgres` directly and never loads
# @lastest/db's instrumented client, so the DB spans in packages/db/src/tracing.ts
# cannot apply here; wiring OTel in would mean adding the whole SDK to a one-shot
# Job for a handful of DDL spans. Tracing lives in Dockerfile.app and
# packages/pool-service/Dockerfile only.
#
# Only DATABASE_URL is required at run time (migrate.js + drizzle.config.ts).
# Versions are pinned to the repo lockfile — bump them together.
#
# Build (repo root as context):
#   docker build -f Dockerfile.migrate -t lastest-migrate:latest .
# =============================================================================
FROM node:24-slim

WORKDIR /app

# Exactly the three packages drizzle-kit push needs — no monorepo, no app deps.
RUN npm install --no-audit --no-fund \
      drizzle-kit@0.31.8 \
      drizzle-orm@0.45.2 \
      postgres@3.4.8 \
    && npm cache clean --force

# The schema barrel + the ./schema/ modules it re-exports (their type-only
# @lastest imports are erased by drizzle-kit's esbuild loader), the config that
# points at it, and the migration script. `drizzle-kit push` reads no migration
# files, so the drizzle/ out-dir is intentionally absent.
COPY packages/db/src/schema.ts ./packages/db/src/schema.ts
COPY packages/db/src/schema/ ./packages/db/src/schema/
COPY libs/coverage-model/package.json ./node_modules/@lastest/coverage-model/
COPY libs/coverage-model/src/ ./node_modules/@lastest/coverage-model/src/
COPY drizzle.config.ts ./
COPY scripts/migrate.js ./scripts/migrate.js

# drizzle.config.ts's schema glob also covers ./plugins/*/src/schema.ts (each
# plugin owns its own tables — see that file's own comment). Docker's COPY
# wildcard flattens matched files into one directory instead of preserving
# plugins/<name>/src/, so each plugin needs its own line here — add one
# whenever a new plugin that OWNS TABLES is registered in
# src/lib/core/runtime.ts's MANIFESTS, the same way scripts/migrate.js's
# PRE_CREATE_SQL grows with new tables. Plugins with no `schema` in their
# manifest (events, design-system) must NOT be listed: COPY of a file that
# does not exist fails the build.
# Each plugin schema's own `./types` import is type-only and erases the same
# way the workspace imports above do, so nothing else needs to come along.
COPY plugins/a11y/src/schema.ts ./plugins/a11y/src/schema.ts
COPY plugins/awards/src/schema.ts ./plugins/awards/src/schema.ts
COPY plugins/ci/src/schema.ts ./plugins/ci/src/schema.ts
COPY plugins/data-sources/src/schema.ts ./plugins/data-sources/src/schema.ts
COPY plugins/explorer/src/schema.ts ./plugins/explorer/src/schema.ts
COPY plugins/gamification/src/schema.ts ./plugins/gamification/src/schema.ts
COPY plugins/launch/src/schema.ts ./plugins/launch/src/schema.ts
COPY plugins/playground/src/schema.ts ./plugins/playground/src/schema.ts
COPY plugins/qa-agent/src/schema.ts ./plugins/qa-agent/src/schema.ts
COPY plugins/ranger/src/schema.ts ./plugins/ranger/src/schema.ts
COPY plugins/scheduling/src/schema.ts ./plugins/scheduling/src/schema.ts
COPY plugins/share/src/schema.ts ./plugins/share/src/schema.ts

# Non-root: migrate.js only touches the DB, no filesystem writes outside /app.
RUN useradd --uid 1002 --shell /usr/sbin/nologin --no-create-home migrate && \
    chown -R migrate:migrate /app
USER migrate

# DATABASE_URL must be injected by the deployment — no default.
ENV NODE_ENV=production

LABEL org.opencontainers.image.title="Lastest DB Migrate"
LABEL org.opencontainers.image.description="One-shot schema migration (drizzle-kit push) for the Lastest platform"
LABEL org.opencontainers.image.source="https://github.com/las-team/lastest"

# cwd is /app so migrate.js resolves ./node_modules/.bin/drizzle-kit and
# drizzle.config.ts's ./packages/db/src/schema.ts.
CMD ["node", "scripts/migrate.js"]
